# Thermohydraulique 2D VEF Boussinesq #
# PARALLEL OK 8 #
# Pour etre ok voire les modifs de P Emonot #
dimension 2

Pb_Thermohydraulique_Turbulent pb
Domaine dom
Mailler dom
{
	Pave Entree_g
		{
		Origine $X0 $Y0
		Nombre_de_Noeuds $Nx $Ny 
		Longueurs $channel_width $Ly
		}
		{
		Bord Inlet_1  Y = $Y0   $X0 <= X <= $channel_width
		Bord Gauche_1 X = $X0   $Y0 <= Y <= $Y1
		} ,
	Pave Entree_d
		{
		Origine $channel_width $Y0
		Nombre_de_Noeuds $Nx $Ny 
		Longueurs $Lx4 $Ly
		}
		{
		Bord Inlet_2  Y = $Y0     $channel_width <= X <= $width
		Bord Droite_1 X = $width  $Y0 <= Y <= $Y1
		Bord PE_1     Y = $Y1     $channel_width <= X <= $width
		} ,
				
	Pave PE
		{
		Origine $X0 $Y1
		Nombre_de_Noeuds $Nx $Ny
		Longueurs $channel_width $Ly_PE
		}
		{ 
		Bord Gauche_2 X = $X0            $Y1 <= Y <= $Y2
		Bord Droite_2 X = $channel_width $Y1 <= Y <= $Y2
		} , 
		
	Pave Milieu
		{
		Origine $X0 $Y2
		Nombre_de_Noeuds $Nx $Ny
		Longueurs $channel_width $Ly_mid
		}
		{	
		Bord Gauche_3 X = $X0            $Y2 <= Y <= $channel_height
		Bord Droite_3 X = $channel_width $Y2 <= Y <= $channel_height
		} ,
			
	Pave Haut_g
		{
		Origine $X0 $channel_height
		Nombre_de_Noeuds $Nx $Ny 
		Longueurs $channel_width $Ly
		}
		{
		Bord Outlet_1 Y = $height $X0 <= X <= $channel_width
		Bord Gauche_4 X = $X0     $channel_height <= Y <= $height
		} ,
	Pave Haut_d
		{
		Origine $channel_width $channel_height
		Nombre_de_Noeuds $Nx $Ny 
		Longueurs $Lx4 $Ly
		}
		{
		Bord Outlet_2 Y = $height         $channel_width  <= X <= $width
		Bord Droite_4 X = $width          $channel_height <= Y <= $height
		Bord PE_2     Y = $channel_height $channel_width  <= X <= $width
		} 
}

# END MESH #
# BEGIN PARTITION#
Partition dom
{
	Partition_tool metis { Nb_parts 2 }
	Larg_joint 2
	zones_name DOM
}
#END PARTITION #


VDF dis


Scheme_euler_explicit sch
Read sch
{

 	tmax  0.0
        tmax  0.0100
        dt_min 1.e-20
        dt_max 1.e-1
        dt_impr 1.e-2
        dt_sauv 5.0
        seuil_statio -1.e-8
        facsec 1
        diffusion_implicite 0
}

Associate pb dom
Associate pb sch
Discretize pb dis
 

Read pb
{
Fluide_Incompressible  
{
    beta_th champ_uniforme  1 0.0002
    mu champ_uniforme  1 9.5e-5
    rho champ_uniforme  1 755.2
    cp champ_uniforme  1 4185.0
    lambda champ_uniforme  1 76
    gravite champ_uniforme 2 0 -9.81
    porosites_champ champ_fonc_xyz dom 1 1-$solid*((y>$Y1)*(y<$Ly_PE)*(x>$X0)*(x<$scorpio_cell_x))*1-$solid*((y>$Y1)*(y<$Ly_PE)*(x>($channel_width-$scorpio_cell_x))*(x<$channel_width))
}

	Navier_Stokes_Turbulent
	{ 
	    solveur_pression GCP 
	        {
			precond ssor { omega 1.5 } 
			seuil 1e-8
			impr
		} 
	   # solveur_bar petsc cholesky { impr }  #
	    
	    convection { amont }
	    diffusion  { }
	    sources { Frottement_Poreux { longueur $longueur  c_0 $c_0 c_1 $c_1 } } 
	    
	    initial_conditions { vitesse Champ_Uniforme 2 0. 0. }
	    
	    boundary_conditions 
	      { 	
		Inlet_1  Frontiere_ouverte_vitesse_imposee Champ_Front_Uniforme  2 0. 2.7
		Inlet_2  Frontiere_ouverte_vitesse_imposee Champ_Front_Uniforme  2 0. 2.7
		Outlet_1 Frontiere_ouverte_pression_imposee Champ_Front_Uniforme 1 6150000  
		Outlet_2 Frontiere_ouverte_pression_imposee Champ_Front_Uniforme 1 6150000  
		Gauche_1 paroi_fixe
		Gauche_2 paroi_fixe
		Gauche_3 paroi_fixe
		Gauche_4 paroi_fixe
		Droite_1 paroi_fixe
		Droite_2 paroi_fixe
		Droite_3 paroi_fixe
		Droite_4 paroi_fixe
		PE_1     paroi_fixe 
		PE_2     paroi_fixe 
            }
		
	   Modele_turbulence K_Epsilon 
	    {
		Transport_K_Epsilon
		  {      
			convection { amont }
			diffusion { }
			Sources { Source_Transport_K_Eps_anisotherme { C3_eps 0.9 } , K_eps_conv { longueur 0.000928 c_1 4.55  } }
			initial_conditions { K_Eps Champ_Uniforme 2 1.e-2 1.e-1 }
			boundary_conditions 
			  {		
				Inlet_1  Frontiere_ouverte_K_Eps_impose	Champ_Front_Uniforme 2 0.002 0.005
				Inlet_2  Frontiere_ouverte_K_Eps_impose	Champ_Front_Uniforme 2 0.002 0.005
				Outlet_1 Frontiere_ouverte K_Eps_ext	Champ_Front_Uniforme 2 0.0002 0.0001
				Outlet_2 Frontiere_ouverte K_Eps_ext	Champ_Front_Uniforme 2 0.0002 0.0001
				Gauche_1 Paroi
				Gauche_2 Paroi
				Gauche_3 Paroi
				Gauche_4 Paroi
				Droite_1 Paroi
				Droite_2 Paroi
				Droite_3 Paroi
				Droite_4 Paroi
				PE_1     Paroi 
				PE_2     Paroi 						
								
		          }
			
		 }
	   
	      Turbulence_paroi Loi_standard_hydr dt_impr_ustar 0.1			
	   }
	}
	 
	 
	 
	 Convection_Diffusion_Temperature_Turbulent 
	   {
                diffusion { }
                convection { amont }
                sources { }
                boundary_conditions 
                	{
 				Inlet_1  frontiere_ouverte_temperature_imposee Champ_Front_Uniforme 1  461.15 # 588.15 #
				Inlet_2  frontiere_ouverte_temperature_imposee Champ_Front_Uniforme 1  461.15 # 588.15 #
				Outlet_1 frontiere_ouverte_temperature_imposee Champ_Front_Uniforme 1  461.15 # 588.15 #
				Outlet_2 frontiere_ouverte_temperature_imposee Champ_Front_Uniforme 1  461.15 # 588.15 #
				Gauche_1 paroi_temperature_imposee Champ_front_Uniforme 1 450.35
				Gauche_2 paroi_temperature_imposee Champ_front_Uniforme 1 450.35
				Gauche_3 paroi_temperature_imposee Champ_front_Uniforme 1 450.35
				Gauche_4 paroi_temperature_imposee Champ_front_Uniforme 1 450.35
				Droite_1 paroi_temperature_imposee Champ_front_Uniforme 1 450.35
				Droite_2 paroi_temperature_imposee Champ_front_Uniforme 1 500
				Droite_3 paroi_temperature_imposee Champ_front_Uniforme 1 500
				Droite_4 paroi_temperature_imposee Champ_front_Uniforme 1 450.35
				PE_1     paroi_temperature_imposee Champ_front_Uniforme 1 500 
				PE_2     paroi_temperature_imposee Champ_front_Uniforme 1 500                		
		      }
	      Modele_Turbulence Prandtl 
	      	      {
	      		 turbulence_paroi loi_standard_hydr_scalaire Prdt 0.9 # *(x>1) dt_impr_nusselt 1.e-4 #  
	      	      }
             initial_conditions 
                      {
                        temperature Champ_Uniforme 1 461.15 
                      }
	  }

	
	
	
	Post_processings 
	{  
	post_dom {
		Probes
                	{ 

			
			sonde_vbas        nodes vitesse  periode 5.e-1 segment 20 $X0  -0.006 $width  -0.006
	                sonde_vchannel    nodes vitesse  periode 5.e-1 segment 20 $X1  0.00075  $X3      0.00075 
	                sonde_vhaut       nodes vitesse  periode 5.e-1 segment 20 $X0  0.006  $channel_width  0.006
	                sonde_pression    nodes pression periode 5.e-1 segment 50 0.00117  $Y0  0.00117  $Y4
	                sonde_v_verticale nodes vitesse  periode 5.e-1 segment 50 0.00117  $Y0  0.00117  $Y4
			
			# sonde_vitesseX nodes vitesseX periode 5.e-1 segment 50 $X0  0.006 $channel_width  0.006 #
			# sonde_vitesseY nodes vitesseY periode 5.e-1 segment 50 0.00117  -0.002 0.00117  0.012 #
			sonde_viscosite viscosite_turbulente periode 5.e-1 segment 50 0.00139 0. 0.00139 0.012
			sonde_temp_fluide_paroi temperature periode 5.e-1 segment 50 0.00139 0. 0.00139 0.012 
			} 
 
 
	        fichier VenaContracta
	  	format lata 
		fields dt_post 0.0005
		{
			viscosite_turbulente som
			vitesse elem 
			vitesse som
			
			# vitesse faces #
			temperature elem
			temperature som
			porosite_volumique som
			porosite_volumique elem
			pression elem
			pression som
			velocity
			K som
			eps som 
		}
	}
 
	}


}
Solve pb 
End
